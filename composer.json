{
  "name": "zakafk/filament-translatable-select",
  "description": "This package adds a way to interact with zakafk/translatable-select in Filament.",
  "homepage": "https://github.com/zakafk/filament-translatable-select",
  "license": "MIT",
  "authors": [
    {
      "name": "Zak Afk",
      "email": "hi@zak.ge"
    }
  ],
  "require": {
    "php": "^8.1",
    "filament/filament": "^4.0",
    "laravel/framework": "^10.0|^11.0|^12.0",
    "spatie/laravel-package-tools": "^1.16",
    "spatie/laravel-translatable": "^6.6"
  },
  "require-dev": {
    "larastan/larastan": "^2.9|^3.0",
    "laravel/pint": "^1.14",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "pestphp/pest": "^2.0|^3.0",
    "pestphp/pest-plugin-laravel": "^2.0|^3.0"
  },
  "autoload": {
    "psr-4": {
      "Zakafk\\FilamentTranslatableSelect\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zakafk\\FilamentTranslatableSelect\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zakafk\\FilamentTranslatableSelect\\FilamentTranslatableSelectServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
